# ============================================
# Portfolio Environment Variables Template
# ============================================
# Copy this file to .env and fill with your actual values

# --------------------------------------------
# Projects & Tools - AutoCare APK
# --------------------------------------------
# Google Drive File ID for AutoCare APK download
# How to get it:
# 1. Upload AutoCare.apk to Google Drive
# 2. Right-click → "Share" → "Anyone with the link"
# 3. Copy link (format: https://drive.google.com/file/d/FILE_ID_HERE/view)
# 4. Extract the FILE_ID_HERE part and paste below
PUBLIC_AUTOCARE_APK_FILE_ID=YOUR_GOOGLE_DRIVE_FILE_ID_HERE

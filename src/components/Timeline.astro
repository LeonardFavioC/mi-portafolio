---
const timelineItems = [
  {
    key: "ioet",
    year: "2019 - Presente",
    title: "Senior Software Engineer & Tech Lead",
    company: "ioet.inc",
    type: "work",
    description:
      "Liderando equipos de desarrollo en proyectos internacionales, implementando arquitecturas escalables y mentoreando desarrolladores junior.",
    achievements: [
      "Liderazgo técnico de equipo distribuido de 8 personas",
      "Implementación de arquitecturas de microservicios",
      "Reducción de tiempos de deployment en 60%",
      "Mentoría y code reviews para equipo de desarrollo",
    ],
    technologies: ["React", "Node.js", "Docker", "AWS", "GraphQL"],
  },
  {
    key: "master",
    year: "2021 - 2023",
    title: "Magíster en Software",
    company: "UTMACH - Universidad Técnica de Machala",
    type: "education",
    description:
      "Especialización en desarrollo de software avanzado, arquitectura de sistemas y metodologías ágiles.",
    achievements: [
      "Investigación en arquitecturas de software escalables",
      "Desarrollo de proyectos con IA y Machine Learning",
      "Tesis sobre optimización de sistemas distribuidos",
    ],
  },
  {
    key: "engineer",
    year: "2017 - 2019",
    title: "Software Engineer",
    company: "Pupilabox & DBase Loja",
    type: "work",
    description:
      "Desarrollo full-stack de aplicaciones web y móviles para diversos clientes, desde startups hasta empresas establecidas.",
    achievements: [
      "Desarrollo de 15+ aplicaciones web y móviles",
      "Implementación de soluciones e-commerce",
      "Integración de sistemas de pago y APIs externas",
      "Optimización de rendimiento y SEO",
    ],
    technologies: ["Angular", "Flutter", "MongoDB", "Firebase"],
  },
  {
    key: "degree",
    year: "2013 - 2018",
    title: "Ingeniero en Sistemas",
    company: "UNL - Universidad Nacional de Loja",
    type: "education",
    description:
      "Formación integral en ciencias de la computación, programación y desarrollo de sistemas.",
    achievements: [
      "Especialización en desarrollo de software",
      "Proyectos de investigación en tecnologías emergentes",
      "Prácticas profesionales en empresas locales",
    ],
  },
  {
    key: "highschool",
    year: "2005 - 2011",
    title: "Bachillerato Técnico en Informática",
    company: "Colegio La Dolorosa - Loja",
    type: "education",
    description:
      "Formación técnica en informática con enfoque en programación, redes y mantenimiento de equipos.",
    achievements: [
      "Especialización en desarrollo de aplicaciones básicas",
      "Conocimientos en redes de computadoras",
      "Mantenimiento y ensamblaje de equipos",
      "Primeros fundamentos de programación",
    ],
  },
];
---

<section id="trayectoria" class="py-20 px-4 bg-white dark:bg-gray-900">
  <div class="max-w-5xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16 animate-fadeInUp">
      <div
        class="inline-flex items-center gap-2 px-4 py-2 mb-4 bg-green-100 dark:bg-green-900/30 rounded-full"
      >
        <svg
          class="w-5 h-5 text-green-600 dark:text-green-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
          ></path>
        </svg>
        <span class="text-sm font-semibold text-green-700 dark:text-green-300" data-i18n="timeline.badge"
          >Trayectoria Profesional</span
        >
      </div>

      <h2
        class="text-3xl md:text-5xl font-bold mb-4 text-gray-900 dark:text-white"
        data-i18n="timeline.title"
      >
        Experiencia y Educación
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto" data-i18n="timeline.subtitle">
        Un recorrido de formación continua y crecimiento profesional
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div
        class="absolute left-8 md:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-blue-500 via-purple-500 to-green-500"
      >
      </div>

      <!-- Timeline Items -->
      <div class="space-y-12">
        {
          timelineItems.map((item, index) => {
            const isWork = item.type === "work";
            const iconColor = isWork
              ? "bg-blue-500"
              : "bg-green-500";
            const icon = isWork
              ? `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`
              : `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />`;

            return (
              <div
                class={`relative flex items-start ${index % 2 === 0 ? "md:flex-row" : "md:flex-row-reverse"} gap-8`}
              >
                {/* Timeline dot */}
                <div class="absolute left-8 md:left-1/2 -translate-x-1/2 z-10">
                  <div
                    class={`w-16 h-16 ${iconColor} rounded-full flex items-center justify-center shadow-lg ring-4 ring-white dark:ring-gray-900`}
                  >
                    <svg
                      class="w-8 h-8 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      set:html={icon}
                    />
                  </div>
                </div>

                {/* Content card */}
                <div
                  class={`w-full md:w-[calc(50%-4rem)] ${index % 2 === 0 ? "md:pr-8 pl-24" : "md:pl-8 pl-24 md:text-right"}`}
                >
                  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 hover:shadow-xl transition-all timeline-item">
                    {/* Header */}
                    <div class="mb-4">
                      <span
                        class={`inline-block px-3 py-1 text-sm font-semibold rounded-full mb-3 ${isWork ? "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300" : "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300"}`}
                      >
                        {item.year}
                      </span>
                      <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-1" data-i18n={`timeline.items.${item.key}.title`}>
                        {item.title}
                      </h3>
                      <p class="text-blue-600 dark:text-blue-400 font-semibold">
                        {item.company}
                      </p>
                    </div>

                    {/* Description */}
                    <p class="text-gray-600 dark:text-gray-400 mb-4" data-i18n={`timeline.items.${item.key}.description`}>
                      {item.description}
                    </p>

                    {/* Toggle button */}
                    <button
                      data-timeline-toggle
                      class="flex items-center gap-2 text-blue-600 dark:text-blue-400 font-semibold hover:gap-3 transition-all mb-4"
                      aria-expanded="false"
                    >
                      <span data-i18n="timeline.showDetails">Ver detalles</span>
                      <svg
                        class="w-5 h-5 transition-transform timeline-arrow"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M19 9l-7 7-7-7"
                        />
                      </svg>
                    </button>

                    {/* Expandable content */}
                    <div class="timeline-content overflow-hidden max-h-0 transition-all duration-300">
                      <div class="pt-4 border-t border-gray-200 dark:border-gray-700">
                        {/* Achievements */}
                        {item.achievements && (
                          <div class="mb-4">
                            <h4 class="font-semibold text-gray-900 dark:text-white mb-2" data-i18n={isWork ? "timeline.achievements" : "timeline.keyAspects"}>
                              {isWork ? "Logros destacados:" : "Aspectos clave:"}
                            </h4>
                            <ul class="space-y-2">
                              {item.achievements.map((achievement, achIndex) => (
                                <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-400">
                                  <svg
                                    class="w-5 h-5 flex-shrink-0 text-green-500 mt-0.5"
                                    fill="currentColor"
                                    viewBox="0 0 20 20"
                                  >
                                    <path
                                      fill-rule="evenodd"
                                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                      clip-rule="evenodd"
                                    />
                                  </svg>
                                  <span data-i18n={`timeline.items.${item.key}.achievements.${achIndex}`}>{achievement}</span>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}

                        {/* Technologies */}
                        {item.technologies && (
                          <div>
                            <h4 class="font-semibold text-gray-900 dark:text-white mb-2 text-sm" data-i18n="timeline.technologies">
                              Tecnologías:
                            </h4>
                            <div class="flex flex-wrap gap-2">
                              {item.technologies.map((tech) => (
                                <span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-xs rounded-full">
                                  {tech}
                                </span>
                              ))}
                            </div>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>

                {/* Empty space for alternating layout */}
                <div class="hidden md:block w-[calc(50%-4rem)]" />
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { translations, type Language } from "../i18n/translations";

  function initTimeline() {
    const toggleButtons = document.querySelectorAll("[data-timeline-toggle]");

    toggleButtons.forEach((button) => {
      button.addEventListener("click", () => {
        // Encontrar el contenido y la flecha más cercanos
        const content = button.parentElement?.querySelector(".timeline-content");
        const arrow = button.querySelector(".timeline-arrow");

        if (content && arrow) {
          // Toggle de clases
          content.classList.toggle("expanded");
          arrow.classList.toggle("rotated");

          // Actualizar aria-expanded para accesibilidad
          const isExpanded = content.classList.contains("expanded");
          button.setAttribute("aria-expanded", isExpanded.toString());

          // Cambiar texto del botón con traducción
          const span = button.querySelector("span");
          if (span) {
            const currentLang = (localStorage.getItem("language") as Language) || "es";
            const t = translations[currentLang];
            span.textContent = isExpanded ? t.timeline.hideDetails : t.timeline.showDetails;
          }
        }
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initTimeline);
</script>

<style>
  .timeline-content.expanded {
    max-height: 500px;
  }

  .timeline-arrow.rotated {
    transform: rotate(180deg);
  }
</style>

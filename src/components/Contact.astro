---
const contactInfo = {
  email: "lcaraguayc@gmail.com",
  phone: "+593 983886370",
  whatsapp: "https://wa.me/593983886370",
  linkedin: "https://www.linkedin.com/in/leonardo-caraguay-270893195",
  github: "https://github.com/LeonardFavioC",
  location: "Loja, Ecuador",
};

const whatsappMessage = encodeURIComponent(
  "Hola Leonardo! Me gustaría contactarte sobre un proyecto."
);
---

<section id="contacto" class="py-20 px-4 bg-gray-50 dark:bg-gray-800/50">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16 animate-fadeInUp">
      <div
        class="inline-flex items-center gap-2 px-4 py-2 mb-4 bg-blue-100 dark:bg-blue-900/30 rounded-full"
      >
        <svg
          class="w-5 h-5 text-blue-600 dark:text-blue-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
          ></path>
        </svg>
        <span class="text-sm font-semibold text-blue-700 dark:text-blue-300" data-i18n="contact.badge"
          >Contacto</span
        >
      </div>

      <h2
        class="text-3xl md:text-5xl font-bold mb-4 text-gray-900 dark:text-white"
        data-i18n="contact.title"
      >
        Hablemos de Tu Proyecto
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto" data-i18n="contact.subtitle">
        Estoy disponible para nuevos proyectos y colaboraciones. ¡Contáctame!
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-12">
      <!-- Contact Info Cards -->
      <div class="space-y-6">
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg">
          <h3
            class="text-2xl font-bold mb-6 text-gray-900 dark:text-white"
            data-i18n="contact.info"
          >
            Información de Contacto
          </h3>

          <div class="space-y-4">
            <!-- WhatsApp -->
            <a
              href={`${contactInfo.whatsapp}?text=${whatsappMessage}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 bg-green-50 dark:bg-green-900/20 rounded-xl hover:bg-green-100 dark:hover:bg-green-900/30 transition-colors group"
            >
              <div
                class="flex-shrink-0 w-12 h-12 bg-green-500 rounded-lg flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6 text-white"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                  ></path>
                </svg>
              </div>
              <div class="flex-grow">
                <div
                  class="text-sm text-gray-600 dark:text-gray-400 font-medium"
                >
                  WhatsApp
                </div>
                <div
                  class="text-gray-900 dark:text-white font-semibold group-hover:text-green-600 dark:group-hover:text-green-400"
                >
                  {contactInfo.phone}
                </div>
              </div>
              <svg
                class="w-5 h-5 text-gray-400 group-hover:text-green-600 dark:group-hover:text-green-400 group-hover:translate-x-1 transition-all"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </a>

            <!-- Email -->
            <a
              href={`mailto:${contactInfo.email}`}
              class="flex items-center gap-4 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-xl hover:bg-blue-100 dark:hover:bg-blue-900/30 transition-colors group"
            >
              <div
                class="flex-shrink-0 w-12 h-12 bg-blue-500 rounded-lg flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <div class="flex-grow">
                <div
                  class="text-sm text-gray-600 dark:text-gray-400 font-medium"
                >
                  Email
                </div>
                <div
                  class="text-gray-900 dark:text-white font-semibold group-hover:text-blue-600 dark:group-hover:text-blue-400 break-all"
                >
                  {contactInfo.email}
                </div>
              </div>
              <svg
                class="w-5 h-5 text-gray-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 group-hover:translate-x-1 transition-all"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </a>

            <!-- Location -->
            <div
              class="flex items-center gap-4 p-4 bg-gray-100 dark:bg-gray-700/50 rounded-xl"
            >
              <div
                class="flex-shrink-0 w-12 h-12 bg-gray-500 rounded-lg flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div class="flex-grow">
                <div
                  class="text-sm text-gray-600 dark:text-gray-400 font-medium"
                  data-i18n="contact.location"
                >
                  Ubicación
                </div>
                <div class="text-gray-900 dark:text-white font-semibold">
                  {contactInfo.location}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Social Links -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg">
          <h3
            class="text-xl font-bold mb-4 text-gray-900 dark:text-white"
            data-i18n="contact.social"
          >
            Sígueme en
          </h3>
          <div class="flex gap-4">
            <a
              href={contactInfo.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 flex items-center justify-center gap-2 p-4 bg-blue-600 hover:bg-blue-700 text-white rounded-xl transition-colors font-semibold"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path>
              </svg>
              LinkedIn
            </a>
            <a
              href={contactInfo.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 flex items-center justify-center gap-2 p-4 bg-gray-800 hover:bg-gray-900 text-white rounded-xl transition-colors font-semibold"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                ></path>
              </svg>
              GitHub
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Contact Form -->
      <div class="bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-lg">
        <h3 class="text-2xl font-bold mb-2 text-gray-900 dark:text-white" data-i18n="contact.quickMessage">
          Mensaje Rápido
        </h3>
        <p class="text-gray-600 dark:text-gray-400 mb-6" data-i18n="contact.quickDesc">
          O envíame un mensaje directo desde aquí
        </p>

        <form id="contact-form" class="space-y-4">
          <div>
            <label
              for="name"
              class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2"
              data-i18n="contact.form.name"
            >
              Nombre
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900 dark:text-white transition-colors"
              placeholder="Tu nombre"
              data-i18n-placeholder="contact.form.namePlaceholder"
            />
          </div>

          <div>
            <label
              for="email"
              class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2"
              data-i18n="contact.form.email"
            >
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900 dark:text-white transition-colors"
              placeholder="tu@email.com"
              data-i18n-placeholder="contact.form.emailPlaceholder"
            />
          </div>

          <div>
            <label
              for="message"
              class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2"
              data-i18n="contact.form.message"
            >
              Mensaje
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900 dark:text-white transition-colors resize-none"
              placeholder="Cuéntame sobre tu proyecto..."
              data-i18n-placeholder="contact.form.messagePlaceholder"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-semibold py-4 px-6 rounded-lg shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-300 flex items-center justify-center gap-2"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
            </svg>
            <span data-i18n="contact.form.send">Enviar Mensaje</span>
          </button>
        </form>

        <p class="mt-4 text-sm text-gray-500 dark:text-gray-400 text-center">
          <span data-i18n="contact.form.also">También puedes contactarme directamente por</span> <a
            href={`${contactInfo.whatsapp}?text=${whatsappMessage}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-green-600 dark:text-green-400 font-semibold hover:underline"
            >WhatsApp</a
          >
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  function initContactForm() {
    const form = document.getElementById("contact-form");
    if (!form) return;

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      const formData = new FormData(form as HTMLFormElement);
      const name = formData.get("name");
      const email = formData.get("email");
      const message = formData.get("message");

      // Crear mensaje para WhatsApp
      const whatsappMessage = encodeURIComponent(
        `Hola Leonardo! Soy ${name} (${email}).\n\n${message}`
      );

      // Redirigir a WhatsApp
      window.open(
        `https://wa.me/593983886370?text=${whatsappMessage}`,
        "_blank"
      );

      // Opcional: Limpiar formulario
      (form as HTMLFormElement).reset();
    });
  }

  document.addEventListener("DOMContentLoaded", initContactForm);
</script>

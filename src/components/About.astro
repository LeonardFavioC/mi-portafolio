---
---

<section id="sobre-mi" class="py-20 px-4 bg-gray-50 dark:bg-gray-800/50">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12 animate-fadeInUp">
      <h2
        class="text-3xl md:text-4xl font-bold mb-4 text-gray-900 dark:text-white"
        data-i18n="about.title"
      >
        ¿Por qué confiar en mi servicio?
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto" data-i18n="about.subtitle">
        No contratas a un principiante, sino a un profesional con trayectoria
        comprobada
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 items-center">
      <!-- Image/Avatar section -->
      <div class="relative">
        <div
          class="relative w-full aspect-square max-w-md mx-auto rounded-2xl overflow-hidden shadow-2xl bg-gradient-to-br from-blue-500 to-purple-600 p-4 sm:p-6 md:p-8"
        >
          <img
            src="/logo.png"
            alt="Leonardo Caraguay"
            class="w-full h-full object-contain"
          />
          <div
            class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/90 to-transparent p-4 sm:p-6"
          >
            <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-white mb-1">
              Leonardo Caraguay
            </h3>
            <p class="text-sm sm:text-base text-blue-300">Senior Software Engineer & Tech Lead</p>
          </div>
        </div>

        <!-- Floating badges -->
        <div
          class="hidden md:block absolute -top-4 -right-4 bg-white dark:bg-gray-800 rounded-xl shadow-lg p-4 animate-float"
        >
          <div class="flex items-center gap-2">
            <svg
              class="w-6 h-6 text-yellow-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
            <span class="text-sm font-semibold text-gray-900 dark:text-white"
              >Tech Lead</span
            >
          </div>
        </div>
      </div>

      <!-- Content section -->
      <div class="space-y-6">
        <div class="space-y-4">
          <div
            class="flex items-start gap-3 p-4 bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow"
          >
            <div
              class="flex-shrink-0 w-10 h-10 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-blue-600 dark:text-blue-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
                ></path>
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 dark:text-white mb-1" data-i18n="about.education.title">
                Formación Académica Sólida
              </h4>
              <p class="text-sm text-gray-600 dark:text-gray-400" data-i18n="about.education.desc" data-i18n-html>
                <strong>Magíster en Software</strong> (UTMACH) e <strong
                  >Ingeniero en Sistemas</strong
                > (UNL) con especialización en desarrollo de soluciones
                escalables.
              </p>
            </div>
          </div>

          <div
            class="flex items-start gap-3 p-4 bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow"
          >
            <div
              class="flex-shrink-0 w-10 h-10 bg-purple-100 dark:bg-purple-900/30 rounded-lg flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-purple-600 dark:text-purple-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 dark:text-white mb-1" data-i18n="about.experience.title">
                +7 Años de Experiencia Profesional
              </h4>
              <p class="text-sm text-gray-600 dark:text-gray-400" data-i18n="about.experience.desc" data-i18n-html>
                Senior Software Engineer & Tech Lead en <strong>ioet.inc</strong
                >, liderando proyectos para empresas internacionales. Experiencia
                previa en <strong>Pupilabox</strong> y <strong
                  >DBase Loja</strong
                >.
              </p>
            </div>
          </div>

          <div
            class="flex items-start gap-3 p-4 bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow"
          >
            <div
              class="flex-shrink-0 w-10 h-10 bg-green-100 dark:bg-green-900/30 rounded-lg flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-green-600 dark:text-green-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 dark:text-white mb-1" data-i18n="about.ai.title">
                Desarrollo Acelerado con IA
              </h4>
              <p class="text-sm text-gray-600 dark:text-gray-400" data-i18n="about.ai.desc" data-i18n-html">
                Aprovecho herramientas avanzadas de IA (<strong
                  >Claude Code, Cursor, Copilot</strong
                >) para acelerar tiempos de desarrollo hasta en un <strong
                  >70%</strong
                >, trasladando ese ahorro directamente al costo final.
              </p>
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="pt-4">
          <a
            href="#contacto"
            class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 font-semibold hover:gap-3 transition-all"
          >
            <span data-i18n="about.cta">Hablemos de tu proyecto</span>
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
</style>

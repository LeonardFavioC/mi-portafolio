---
import LanguageToggle from "./LanguageToggle.astro";

const currentYear = new Date().getFullYear();

const footerLinks = {
  sections: [
    {
      key: "navigation",
      title: "Navegación",
      links: [
        { key: "home", text: "Inicio", href: "#hero" },
        { key: "about", text: "Sobre Mí", href: "#sobre-mi" },
        { key: "services", text: "Servicios", href: "#servicios" },
        { key: "techStack", text: "Tech Stack", href: "#tech-stack" },
        { key: "experience", text: "Trayectoria", href: "#trayectoria" },
        { key: "contact", text: "Contacto", href: "#contacto" },
      ],
    },
    {
      key: "services",
      title: "Servicios",
      links: [
        { key: "landing", text: "Landing Page Express", href: "#servicios" },
        { key: "corporate", text: "Sitio Corporativo Pro", href: "#servicios" },
        { key: "custom", text: "Desarrollo a Medida", href: "#servicios" },
      ],
    },
    {
      key: "contact",
      title: "Contacto",
      links: [
        {
          text: "WhatsApp",
          href: "https://wa.me/593983886370",
          external: true,
        },
        { text: "Email", href: "mailto:lfcaraguayc@gmail.com", external: true },
        {
          text: "LinkedIn",
          href: "https://www.linkedin.com/in/leonardo-caraguay-270893195",
          external: true,
        },
        {
          text: "GitHub",
          href: "https://github.com/LeonardFavioC",
          external: true,
        },
      ],
    },
  ],
};
---

<footer class="bg-gray-900 text-gray-300 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4">
    <!-- Main Footer Content -->
    <div class="grid md:grid-cols-4 gap-8 mb-12">
      <!-- Brand Column -->
      <div class="md:col-span-1">
        <div class="mb-4">
          <h3 class="text-2xl font-bold text-white mb-2">Leonardo Caraguay</h3>
          <p class="text-blue-400 font-semibold text-sm">
            Senior Software Engineer
          </p>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed mb-4" data-i18n="footer.tagline">
          Desarrollo web ultra rápido y económico impulsado por IA. Transformo
          ideas en realidad digital.
        </p>

        <!-- Social Links -->
        <div class="flex gap-3">
          <a
            href="https://www.linkedin.com/in/leonardo-caraguay-270893195"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-gray-800 hover:bg-blue-600 rounded-lg flex items-center justify-center transition-colors"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
          <a
            href="https://github.com/LeonardFavioC"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-gray-800 hover:bg-gray-700 rounded-lg flex items-center justify-center transition-colors"
            aria-label="GitHub"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
          </a>
          <a
            href="https://wa.me/593983886370"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-gray-800 hover:bg-green-600 rounded-lg flex items-center justify-center transition-colors"
            aria-label="WhatsApp"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Links Columns -->
      {
        footerLinks.sections.map((section) => (
          <div>
            <h4 class="text-white font-bold mb-4" data-i18n={`footer.${section.key}`}>{section.title}</h4>
            <ul class="space-y-2">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    class="text-sm text-gray-400 hover:text-white transition-colors inline-flex items-center gap-1 group"
                    data-i18n={link.key ? `footer.links.${link.key}` : undefined}
                  >
                    {link.text}
                    {link.external && (
                      <svg
                        class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                      </svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom Bar -->
    <div
      class="pt-8 border-t border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <div class="text-sm text-gray-500">
        © {currentYear} Leonardo Caraguay. <span data-i18n="footer.copyright">Todos los derechos reservados.</span>
      </div>

      <div class="flex items-center gap-6">
        <div class="text-sm text-gray-500">
          <span data-i18n="footer.madeWith">Hecho con</span>
          <span class="text-red-500">♥</span> <span data-i18n="footer.using">usando</span>
          <a
            href="https://astro.build"
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-400 hover:text-blue-300 font-semibold">Astro</a
          > + IA
        </div>

        <div class="flex items-center gap-2">
          <!-- Language Toggle -->
          <LanguageToggle />

          <!-- Theme Toggle -->
          <button
            data-theme-toggle
            class="p-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors"
            aria-label="Toggle theme"
          >
          <svg
            class="w-5 h-5 dark:hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
          <svg
            class="w-5 h-5 hidden dark:block"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</footer>
